# ============================================
# AnyRouter Pool 配置文件
# ============================================
# 复制此文件为 .env 并根据需要修改配置
#
# 快速开始:
#   独立版: docker compose -f docker-compose.standalone.yml up -d
#   完整版: docker compose -f docker-compose.full.yml up -d

# ============================================
# 代理配置（访问 AnyRouter 主站需要）
# ============================================
# HTTP 代理地址，格式: http://host:port
# 留空表示不使用代理（可能无法访问主站）
# 示例:
#   - Windows/Mac Docker Desktop: http://host.docker.internal:7890
#   - Linux Docker: http://172.17.0.1:7890
HTTP_PROXY=

# ============================================
# 端口配置
# ============================================
# AnyRouter Pool 服务端口
POOL_PORT=18081
# NewAPI 服务端口（完整版需要）
NEWAPI_PORT=13000

# ============================================
# 时区
# ============================================
TZ=Asia/Shanghai

# ============================================
# 签到配置
# ============================================
# 是否启用自动签到
CHECKIN_ENABLED=true
# 签到执行时间（小时，多个用逗号分隔）
CHECKIN_CRON_HOUR=2,8,14,20
# 签到执行时间（分钟）
CHECKIN_CRON_MINUTE=30
# 签到失败重试次数
CHECKIN_MAX_RETRIES=3
# 签到重试间隔（秒）
CHECKIN_RETRY_DELAY=3

# ============================================
# 主站优先恢复配置 (v2.1)
# ============================================
# 启用后会定期检查主站健康状态，可用时自动切换回主站
PRIMARY_SITE_CHECK_ENABLED=true
# 检查间隔（分钟）
PRIMARY_SITE_CHECK_INTERVAL=5
# 紧急检查间隔（分钟），当不在主站时使用更短间隔
PRIMARY_SITE_CHECK_INTERVAL_URGENT=1
# 需要连续成功多少次才切换回主站
PRIMARY_SITE_CHECK_REQUIRED_SUCCESSES=2

# ============================================
# 站点管理器配置 (v2.1 - 稳定性增强)
# ============================================
# 是否启用站点管理器
SITE_MANAGER_ENABLED=true
# 连续失败多少次后切换站点
SITE_MAX_CONSECUTIVE_FAILS=5
# 站点冷却时间（秒）
SITE_COOLDOWN_SECONDS=60
# 最大并发请求数
MAX_CONCURRENT_REQUESTS=50
# GC 间隔（秒）
GC_INTERVAL_SECONDS=300
# 是否启用站点告警（全站不可用时发送邮件）
SITE_ALERT_ENABLED=true
# 站点告警冷却时间（秒）
SITE_ALERT_COOLDOWN=300

# ============================================
# 模型降级配置 (v2.1 新增)
# ============================================
# 是否启用模型降级（负载限制时自动切换到可用模型）
MODEL_DEGRADATION_ENABLED=true
# 连续失败多少次后触发降级（用于非负载限制错误）
MODEL_DEGRADATION_THRESHOLD=3
# 最大降级冷却时间（秒），用于指数退避上限
MODEL_DEGRADATION_COOLDOWN=300
# 是否启用模型自动替换（当请求模型不可用时自动切换到其他可用模型）
# - true: 自动切换到可用模型（默认）
# - false: 不切换，直接返回错误
MODEL_AUTO_REPLACE_ENABLED=true
# 立即黑名单冷却时间（秒），首次失败的短冷却期
# 指数退避: 30s → 60s → 120s → 180s(上限)
MODEL_IMMEDIATE_COOLDOWN=30

# ============================================
# 降级策略配置 (v2.1 新增)
# ============================================
# 降级策略:
# - site_first: 先换站点再换模型（推荐，保证用户得到想要的模型）
# - model_first: 先换模型再换站点
DEGRADATION_STRATEGY=site_first
# 最多尝试的降级模型数量
MAX_MODEL_FALLBACKS=3
# 是否允许跨级降级（opus -> haiku）
ALLOW_CROSS_TIER_FALLBACK=true

# ============================================
# 快速失败配置 (v2.1 新增)
# ============================================
# 当所有资源不可用时，立即返回错误而不是长时间等待
FAST_FAIL_ENABLED=true

# ============================================
# 熔断器半开状态配置 (v2.1 新增)
# ============================================
# 是否启用半开状态（冷却期后渐进式恢复）
HALF_OPEN_ENABLED=true
# 站点半开状态持续时间（秒）
SITE_HALF_OPEN_DURATION=30
# 半开状态放行请求比例（0.1 = 10%）
SITE_HALF_OPEN_PASS_RATE=0.1
# 半开状态需要连续成功次数才能完全恢复
SITE_HALF_OPEN_REQUIRED_SUCCESSES=3

# ============================================
# 冷却时间抖动配置 (v2.1 新增)
# ============================================
# 是否启用冷却时间抖动（防止惊群效应）
COOLDOWN_JITTER_ENABLED=true
# 最大抖动时间（秒）
COOLDOWN_JITTER_MAX=10

# ============================================
# NewAPI 集成配置
# ============================================
# NewAPI 服务地址（独立版留空，完整版自动配置）
NEWAPI_URL=

# Dashboard 认证开关
# - true: 需要 NewAPI 超级管理员账号登录
# - false: 无需登录，直接访问（适合个人本地使用）
DASHBOARD_AUTH_ENABLED=false

# API Key 验证开关
# - true: 调用 /v1/* API 需要有效的 NewAPI 令牌
# - false: 无需验证，任何人都可以调用 API
API_KEY_VALIDATION_ENABLED=false

# ============================================
# 完整版专用配置
# ============================================
# NewAPI 外部访问地址（用于 OAuth 回调等）
SERVER_ADDRESS=
# Session 密钥（随机字符串，用于加密 session）
SESSION_SECRET=anyrouter-pool-session-secret-change-me

# ============================================
# 邮件通知配置（可选）
# ============================================
# 是否启用邮件通知（签到失败时发送）
EMAIL_NOTIFY_ENABLED=false
# SMTP 服务器
EMAIL_SMTP_HOST=smtp.163.com
# SMTP 端口（SSL）
EMAIL_SMTP_PORT=465
# 发件人邮箱
EMAIL_SENDER=
# SMTP 授权码（不是登录密码，需要在邮箱设置中获取）
EMAIL_PASSWORD=
# 收件人邮箱
EMAIL_RECEIVER=
