# ============================================
# AnyRouter Pool 配置文件
# ============================================
# 复制此文件为 .env 并根据需要修改配置
#
# 快速开始:
#   独立版: docker compose -f docker-compose.standalone.yml up -d
#   完整版: docker compose -f docker-compose.full.yml up -d

# ============================================
# 代理配置（访问 AnyRouter 主站需要）
# ============================================
# HTTP 代理地址，格式: http://host:port
# 留空表示不使用代理（可能无法访问主站）
# 示例:
#   - Windows/Mac Docker Desktop: http://host.docker.internal:7890
#   - Linux Docker: http://172.17.0.1:7890
HTTP_PROXY=

# ============================================
# 端口配置
# ============================================
# AnyRouter Pool 服务端口
POOL_PORT=18081
# NewAPI 服务端口（完整版需要）
NEWAPI_PORT=13000

# ============================================
# 时区
# ============================================
TZ=Asia/Shanghai

# ============================================
# 签到配置
# ============================================
# 是否启用自动签到
CHECKIN_ENABLED=true
# 签到执行时间（小时，多个用逗号分隔）
CHECKIN_CRON_HOUR=2,8,14,20
# 签到执行时间（分钟）
CHECKIN_CRON_MINUTE=30
# 签到失败重试次数
CHECKIN_MAX_RETRIES=3
# 签到重试间隔（秒）
CHECKIN_RETRY_DELAY=3

# ============================================
# 主站优先恢复配置
# ============================================
# 启用后会定期检查主站健康状态，可用时自动切换回主站
PRIMARY_SITE_CHECK_ENABLED=true
# 检查间隔（分钟）
PRIMARY_SITE_CHECK_INTERVAL=5

# ============================================
# WAF Cookie 配置（高级，一般无需修改）
# ============================================
# Cookie 缓存时间（秒），默认 30 分钟
WAF_COOKIE_TTL=1800
# 预刷新时间（过期前多少秒刷新），默认 5 分钟
WAF_COOKIE_REFRESH_BEFORE=300
# 刷新失败重试间隔（秒）
WAF_COOKIE_RETRY_INTERVAL=30

# ============================================
# 浏览器配置（高级，一般无需修改）
# ============================================
# 浏览器定期重启间隔（小时），防止内存泄漏
BROWSER_RESTART_HOURS=6

# ============================================
# NewAPI 集成配置
# ============================================
# NewAPI 服务地址（独立版留空，完整版自动配置）
NEWAPI_URL=

# Dashboard 认证开关
# - true: 需要 NewAPI 超级管理员账号登录
# - false: 无需登录，直接访问（适合个人本地使用）
DASHBOARD_AUTH_ENABLED=false

# API Key 验证开关
# - true: 调用 /v1/* API 需要有效的 NewAPI 令牌
# - false: 无需验证，任何人都可以调用 API
API_KEY_VALIDATION_ENABLED=false

# ============================================
# 完整版专用配置
# ============================================
# NewAPI 外部访问地址（用于 OAuth 回调等）
SERVER_ADDRESS=
# Session 密钥（随机字符串，用于加密 session）
SESSION_SECRET=anyrouter-pool-session-secret-change-me

# ============================================
# 邮件通知配置（可选）
# ============================================
# 是否启用邮件通知（签到失败时发送）
EMAIL_NOTIFY_ENABLED=false
# SMTP 服务器
EMAIL_SMTP_HOST=smtp.163.com
# SMTP 端口（SSL）
EMAIL_SMTP_PORT=465
# 发件人邮箱
EMAIL_SENDER=
# SMTP 授权码（不是登录密码，需要在邮箱设置中获取）
EMAIL_PASSWORD=
# 收件人邮箱
EMAIL_RECEIVER=
